[
  {
    "id": "types-expressions",
    "category": "language",
    "files": {
      "principal.lumi": "principal { entero n = 3>> decimal d = 1.5>> texto nombre = \"Lumi\">> booleano activo = verdadero>> mostrar(n + 2)>> mostrar(d * 2)>> mostrar(nombre)>> mostrar(activo)>> }"
    },
    "expected": {
      "output": [
        "5",
        "3.0",
        "Lumi",
        "verdadero"
      ]
    }
  },
  {
    "id": "condition-loops",
    "category": "language",
    "files": {
      "principal.lumi": "principal { entero total = 0>> hacer entero i = 0; i < 3; i = i + 1 { total = total + i>> } mientras total < 5 { total = total + 1>> } si total == 5 { mostrar(\"cinco\")>> } sino { mostrar(\"otro\")>> } }"
    },
    "expected": {
      "output": [
        "cinco"
      ]
    }
  },
  {
    "id": "functions-imports",
    "category": "language",
    "files": {
      "principal.lumi": "importar \"calculos.lumi\" usar area>> principal { mostrar(area(6,5))>> }",
      "calculos.lumi": "funcion decimal area(decimal ancho, decimal largo) { retornar ancho * largo>> }"
    },
    "expected": {
      "output": [
        "30"
      ]
    }
  },
