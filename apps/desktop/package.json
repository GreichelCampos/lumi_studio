{
  "name": "lumi-studio-desktop",
  "version": "0.1.0",
  "description": "Entorno de programación educativa Lumi",
  "author": "Estudio Lumi",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "icons:generate": "node scripts/generate-icon.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && npm --prefix renderer run build",
    "lint": "tsc --noEmit && npm --prefix renderer run lint",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs && node tests/electron.integration.mjs",
    "test:window": "node scripts/build.mjs && node tests/window.integration.mjs",
    "test:workspace": "node scripts/build.mjs && node tests/workspace.integration.mjs",
    "test:viewport": "node scripts/build.mjs && node tests/viewport.integration.mjs",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "pack:win": "npm run build && npm run runtime:prepare && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run build && npm run runtime:prepare && electron-builder --win nsis --x64 --publish never",
    "test:packaged": "node tests/packaged.integration.mjs",
    "test:installer": "node tests/installer.integration.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "playwright-core": "1.64.1",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
