  "sources": {
    "principal.lumi": "importar \"calculos.lumi\" usar calcular_area>>\nimportar \"muebles.lumi\" usar organizar_sala>>\n\nprincipal {\n    decimal ancho = 6.0>>\n    decimal largo = 5.0>>\n    decimal alto = 3.0>>\n    decimal area = calcular_area(ancho, largo)>>\n\n    mostrar(\"Area de sala:\")>>\n    mostrar(area)>>\n\n    habitacion sala(ancho, largo, alto) {\n        piso suelo {\n            material \"madera\">>\n            color \"#d6b98c\">>\n        }\n\n        mesa mesa_centro {\n            material \"madera\">>\n            color \"#8b5a2b\">>\n        }\n\n        silla silla_lectura {\n            color \"#2563eb\">>\n        }\n\n        planta planta_ventana {\n            color \"#22c55e\">>\n        }\n\n        colocar mesa_centro [0, 0, 0]>>\n        colocar silla_lectura [-2, 0, -1]>>\n        colocar planta_ventana [2, 0, 1.5]>>\n\n        booleano reorganizar = verdadero>>\n        si reorganizar {\n            organizar_sala(1.5, 0.5)>>\n        }\n\n        hacer entero i = 0; i < 3; i = i + 1 {\n            mover silla_lectura [-2 + i, 0, -1]>>\n        }\n\n        entero angulo = 0>>\n        mientras angulo < 90 {\n            angulo = angulo + 30>>\n            rotar planta_ventana [0, angulo, 0]>>\n        }\n    }\n\n    habitacion estudio(4, 3, 2.6) {\n        piso piso_estudio {\n            material \"madera\">>\n        }\n\n        escritorio escritorio1 {\n            color \"#f8fafc\">>\n        }\n\n        colocar escritorio1 [0, 0, 0]>>\n        rotar escritorio1 [0, 90, 0]>>\n    }\n}\n",
    "calculos.lumi": "funcion decimal calcular_area(decimal ancho, decimal largo) {\n    retornar ancho * largo>>\n}\n",
    "muebles.lumi": "funcion vacio organizar_sala(decimal x, decimal z) {\n    mover mesa_centro [x, 0, z]>>\n    rotar mesa_centro [0, 90, 0]>>\n}\n"
  },
