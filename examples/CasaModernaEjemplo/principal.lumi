funcion vacio organizar_comedor() {
    colocar mesa_comedor [0, 0, 0]>>
    colocar silla_comedor_1 [-0.9, 0, -0.9]>>
    colocar silla_comedor_2 [0, 0, -0.9]>>
    colocar silla_comedor_3 [0.9, 0, -0.9]>>
    colocar silla_comedor_4 [-0.9, 0, 0.9]>>
    colocar silla_comedor_5 [0, 0, 0.9]>>
    colocar silla_comedor_6 [0.9, 0, 0.9]>>

    rotar silla_comedor_1 [0, 180, 0]>>
    rotar silla_comedor_2 [0, 180, 0]>>
    rotar silla_comedor_3 [0, 180, 0]>>
}

funcion vacio amueblar_terraza() {
    colocar mesa_terraza [0, 0, 0]>>
    colocar silla_terraza_1 [-1, 0, 0]>>
    colocar silla_terraza_2 [1, 0, 0]>>
    colocar planta_terraza_1 [-2.7, 0, 1.2]>>
    colocar planta_terraza_2 [2.7, 0, 1.2]>>
    rotar silla_terraza_1 [0, 90, 0]>>
    rotar silla_terraza_2 [0, -90, 0]>>
}

principal {
    mostrar("Casa moderna preparada")>>

    habitacion sala(8, 6, 3.2) {
        piso piso_sala {
            color "#d6d3d1">>
            material "madera">>
        }
        pared muro_sala_oeste {
            orientacion "oeste">>
            color "#f8fafc">>
            material "concreto">>
        }
        puerta entrada_sala {
            orientacion "norte">>
            ancho 1.1>>
            alto 2.2>>
            desplazamiento 0.5>>
            color "#713f12">>
            material "madera">>
        }
        ventana ventanal_sala {
            orientacion "sur">>
            ancho 2.8>>
            alto 1.3>>
            desplazamiento 2.6>>
            elevacion 0.9>>
            material "vidrio">>
        }

        sofa sofa_principal { color "#334155">> material "tela">> }
        mesa mesa_centro { color "#a16207">> material "madera">> }
        alfombra alfombra_sala { color "#dbeafe">> material "tela">> }
        planta planta_sala_1 { color "#15803d">> }
        planta planta_sala_2 { color "#16a34a">> }
        lampara lampara_sala { color "#fbbf24">> material "metal">> }

        colocar sofa_principal [1.8, 0, 1.8]>>
        rotar sofa_principal [0, 180, 0]>>
        colocar mesa_centro [0.4, 0, 0.5]>>
        colocar alfombra_sala [-1.2, 0, -1.2]>>
        colocar planta_sala_1 [-3.3, 0, 2.2]>>
        colocar planta_sala_2 [3.3, 0, -1.8]>>
        colocar lampara_sala [-2.4, 0, 1.8]>>
    }

    habitacion cocina(6, 5, 3) {
        piso piso_cocina { color "#e7e5e4">> material "ceramica">> }
        puerta acceso_cocina {
            orientacion "norte">> ancho 0.9>> alto 2.1>> desplazamiento 0.4>>
            material "madera">>
        }
        ventana ventana_cocina {
            orientacion "sur">> ancho 1.8>> alto 1.1>> desplazamiento 2.1>>
            elevacion 1.1>> material "vidrio">>
        }
        mesa isla_cocina { color "#f8fafc">> material "piedra">> }
        estanteria despensa_cocina { color "#92400e">> material "madera">> }
        armario almacen_cocina { color "#f1f5f9">> material "madera">> }

        colocar isla_cocina [0, 0, 0.3]>>
        colocar despensa_cocina [-2.35, 0, 1.7]>>
        colocar almacen_cocina [2.25, 0, 1.6]>>
    }

    habitacion comedor(7, 5.5, 3) {
        piso piso_comedor { color "#c4a484">> material "madera">> }
        puerta acceso_comedor {
            orientacion "norte">> ancho 1>> alto 2.1>> desplazamiento 0.5>>
            material "madera">>
        }
        ventana ventana_comedor {
            orientacion "sur">> ancho 2.2>> alto 1.2>> desplazamiento 2.4>>
            elevacion 1>> material "vidrio">>
        }
        mesa mesa_comedor { color "#78350f">> material "madera">> }
        silla silla_comedor_1 { color "#f8fafc">> material "tela">> }
        silla silla_comedor_2 { color "#f8fafc">> material "tela">> }
        silla silla_comedor_3 { color "#f8fafc">> material "tela">> }
        silla silla_comedor_4 { color "#f8fafc">> material "tela">> }
        silla silla_comedor_5 { color "#f8fafc">> material "tela">> }
        silla silla_comedor_6 { color "#f8fafc">> material "tela">> }

        organizar_comedor()>>
    }

    habitacion dormitorio_principal(6, 5, 3) {
        piso piso_principal { color "#d6c7b0">> material "madera">> }
        puerta puerta_principal {
            orientacion "norte">> ancho 0.9>> alto 2.1>> desplazamiento 0.4>>
            material "madera">>
        }
        ventana ventana_principal {
            orientacion "sur">> ancho 2>> alto 1.2>> desplazamiento 2>>
            elevacion 1>> material "vidrio">>
        }
        cama cama_principal { color "#e2e8f0">> material "tela">> }
        armario armario_principal { color "#854d0e">> material "madera">> }
        lampara lampara_principal_1 { color "#fef3c7">> material "metal">> }
        lampara lampara_principal_2 { color "#fef3c7">> material "metal">> }

        colocar cama_principal [1, 0, 0.7]>>
        colocar armario_principal [-2.2, 0, 1.5]>>
        colocar lampara_principal_1 [-0.4, 0, 0.7]>>
        colocar lampara_principal_2 [2.45, 0, 0.7]>>
    }

    habitacion dormitorio_secundario_1(5, 4.5, 3) {
        piso piso_secundario_1 { color "#e7e5e4">> material "madera">> }
        ventana ventana_secundaria_1 {
            orientacion "sur">> ancho 1.5>> alto 1.1>> desplazamiento 1.8>>
            elevacion 1.1>> material "vidrio">>
        }
        cama cama_secundaria_1 { color "#bfdbfe">> material "tela">> }
        escritorio escritorio_secundario_1 { color "#f8fafc">> material "madera">> }
        silla silla_secundaria_1 { color "#2563eb">> material "tela">> }

        colocar cama_secundaria_1 [1.2, 0, 0.5]>>
        colocar escritorio_secundario_1 [-1.55, 0, 1.35]>>
        colocar silla_secundaria_1 [-1.55, 0, 0.45]>>
        rotar silla_secundaria_1 [0, 180, 0]>>
    }

    habitacion dormitorio_secundario_2(5, 4.5, 3) {
        piso piso_secundario_2 { color "#e7e5e4">> material "madera">> }
        ventana ventana_secundaria_2 {
            orientacion "sur">> ancho 1.5>> alto 1.1>> desplazamiento 1.8>>
            elevacion 1.1>> material "vidrio">>
        }
        cama cama_secundaria_2 { color "#ddd6fe">> material "tela">> }
        escritorio escritorio_secundario_2 { color "#f8fafc">> material "madera">> }
        silla silla_secundaria_2 { color "#7c3aed">> material "tela">> }

        colocar cama_secundaria_2 [-1.2, 0, 0.5]>>
        colocar escritorio_secundario_2 [1.55, 0, 1.35]>>
        colocar silla_secundaria_2 [1.55, 0, 0.45]>>
        rotar silla_secundaria_2 [0, 180, 0]>>
    }

    habitacion bano_principal(3.5, 3, 2.8) {
        piso piso_bano_principal { color "#f1f5f9">> material "ceramica">> }
        puerta puerta_bano_principal {
            orientacion "norte">> ancho 0.8>> alto 2.1>> desplazamiento 0.3>>
            material "madera">>
        }
        ventana ventana_bano_principal {
            orientacion "sur">> ancho 0.8>> alto 0.7>> desplazamiento 1.35>>
            elevacion 1.6>> material "vidrio">>
        }
    }

    habitacion bano_secundario(3, 2.8, 2.8) {
        piso piso_bano_secundario { color "#dbeafe">> material "ceramica">> }
        puerta puerta_bano_secundario {
            orientacion "norte">> ancho 0.8>> alto 2.1>> desplazamiento 0.3>>
            material "madera">>
        }
        ventana ventana_bano_secundario {
            orientacion "sur">> ancho 0.7>> alto 0.6>> desplazamiento 1.15>>
            elevacion 1.7>> material "vidrio">>
        }
    }

    habitacion lavanderia(4, 3.5, 2.8) {
        piso piso_lavanderia { color "#e2e8f0">> material "ceramica">> }
        ventana ventana_lavanderia {
            orientacion "sur">> ancho 1.2>> alto 0.9>> desplazamiento 1.4>>
            elevacion 1.3>> material "vidrio">>
        }
        armario armario_lavanderia { color "#f8fafc">> material "madera">> }
        estanteria estante_lavanderia { color "#64748b">> material "metal">> }
        colocar armario_lavanderia [-1.35, 0, 1.1]>>
        colocar estante_lavanderia [1.45, 0, 1.2]>>
    }

    habitacion pasillo(6, 2.5, 2.8) {
        piso piso_pasillo { color "#d6d3d1">> material "madera">> }
        cuadro cuadro_pasillo { color "#0f766e">> material "lienzo">> }
        planta planta_pasillo { color "#22c55e">> }
        colocar cuadro_pasillo [-2.3, 0, 0.8]>>
        colocar planta_pasillo [2.4, 0, 0.7]>>
    }

    habitacion terraza(7, 4, 2.8) {
        piso piso_terraza { color "#a8a29e">> material "piedra">> }
        mesa mesa_terraza { color "#78350f">> material "madera">> }
        silla silla_terraza_1 { color "#f8fafc">> material "madera">> }
        silla silla_terraza_2 { color "#f8fafc">> material "madera">> }
        planta planta_terraza_1 { color "#16a34a">> }
        planta planta_terraza_2 { color "#16a34a">> }
        amueblar_terraza()>>
    }

    habitacion cochera(7, 6, 3) {
        piso piso_cochera { color "#78716c">> material "concreto">> }
        puerta porton_cochera {
            orientacion "norte">> ancho 2.8>> alto 2.4>> desplazamiento 2.1>>
            color "#475569">> material "metal">>
        }
        armario armario_herramientas { color "#334155">> material "metal">> }
        estanteria estante_cochera { color "#64748b">> material "metal">> }
        colocar armario_herramientas [-2.7, 0, 2]>>
        colocar estante_cochera [2.8, 0, 2.2]>>
    }

    habitacion jardin(9, 7, 2.5) {
        piso piso_jardin { color "#65a30d">> material "cesped">> }
        planta planta_jardin_1 { color "#15803d">> }
        planta planta_jardin_2 { color "#16a34a">> }
        planta planta_jardin_3 { color "#22c55e">> }
        planta planta_jardin_4 { color "#15803d">> }
        planta planta_jardin_5 { color "#16a34a">> }
        planta planta_jardin_6 { color "#22c55e">> }

        colocar planta_jardin_1 [-3.8, 0, -2.7]>>
        colocar planta_jardin_2 [-2.2, 0, 2.7]>>
        colocar planta_jardin_3 [0, 0, -2.8]>>
        colocar planta_jardin_4 [2.2, 0, 2.7]>>
        colocar planta_jardin_5 [3.8, 0, -2.7]>>
        colocar planta_jardin_6 [0, 0, 2.8]>>
    }
}
